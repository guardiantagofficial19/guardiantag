# =========================================================
# GUARDIANTAG ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your actual credentials
# =========================================================

# 1. Supabase Connection Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 2. Twilio Telephony Credentials (Optional / Production Proxy)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PROXY_NUMBER="+1xxxxxxxxxx"

# 3. Admin Authentication Secrets (Store Manager)
ADMIN_PASSWORD="your-strong-admin-password"
ADMIN_SESSION_SECRET="64-character-random-secret-string"

# 4. Neon PostgreSQL Database
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"
